<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="model.mapper.StockMapper">

  <!-- 전체 종목 조회 (이름 오름차순) -->
  <!-- mapUnderscoreToCamelCase가 활성화되어 있어 stock_code -> stockCode, current_price -> currentPrice로 자동 매핑됩니다. -->
  <select id="selectAll" resultType="Stock">
    SELECT stock_code, stock_name, current_price 
    FROM Stock 
    ORDER BY stock_name ASC
  </select>

  <!-- 특정 종목 주가 수정 -->
  <update id="updatePrice">
    UPDATE Stock 
    SET current_price = #{price} 
    WHERE stock_code = #{stockCode}
  </update>

</mapper>
